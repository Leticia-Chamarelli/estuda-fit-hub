#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../bootstrap.php';

use EstudaFitHub\Console\CobrancaMigrarUnidade;
use EstudaFitHub\Console\CobrancaRegua;
use EstudaFitHub\Console\CobrancaReverterUnidade;
use EstudaFitHub\Console\CobrancaWorker;
use EstudaFitHub\Console\DbMigrate;
use EstudaFitHub\Console\DbSeed;
use EstudaFitHub\Console\FaturasGerarMensais;
use EstudaFitHub\Console\FaturasMarcarVencidas;
use EstudaFitHub\Console\Reconciliacao;

$comandos = [
    'db:migrate' => [DbMigrate::class, 'Recria o schema do zero (--se-vazio: só se ainda não existir)'],
    'db:seed' => [DbSeed::class, 'Popula dados fictícios (--alunos=N, padrão 2000; --se-vazio)'],
    'faturas:gerar-mensais' => [FaturasGerarMensais::class, 'Cron legado do dia 1º ([YYYY-MM]); ignora unidades migradas'],
    'faturas:marcar-vencidas' => [FaturasMarcarVencidas::class, 'Cron legado diário; ignora unidades migradas'],
    'cobranca:regua' => [CobrancaRegua::class, 'Cron diário: lembretes e bloqueio (--limite=N), lê fin_faturas'],
    'cobranca:worker' => [CobrancaWorker::class, 'Inbox do webhook, outbox e feed de eventos (--uma-vez, --intervalo=N)'],
    'cobranca:migrar-unidade' => [CobrancaMigrarUnidade::class, 'Corte de uma unidade para o serviço (<unidade_id>)'],
    'cobranca:reconciliar' => [Reconciliacao::class, 'Compara legado e serviço de uma unidade (<unidade_id>)'],
    'cobranca:reverter-unidade' => [CobrancaReverterUnidade::class, 'Rollback de uma unidade para o legado (<unidade_id>)'],
];

$nome = $argv[1] ?? '';
if (!isset($comandos[$nome])) {
    fwrite(STDERR, "Uso: php bin/console <comando> [args]\n\nComandos disponíveis:\n");
    foreach ($comandos as $chave => [, $descricao]) {
        fwrite(STDERR, sprintf("  %-26s %s\n", $chave, $descricao));
    }
    exit(1);
}

$inicio = microtime(true);
$codigo = (new $comandos[$nome][0]())->executar(array_slice($argv, 2));
printf("Concluído em %.1fs\n", microtime(true) - $inicio);
exit($codigo);
